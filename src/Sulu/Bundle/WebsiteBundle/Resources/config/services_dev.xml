<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>

        <service
            id="sulu_website.event_listener.not_found_welcome_listener"
            class="Sulu\Bundle\WebsiteBundle\EventListener\NotFoundWelcomeListener">
            <argument type="service" id="twig" />

            <tag name="kernel.event_listener" event="kernel.exception" method="renderWelcomePage" />
        </service>
    </services>
</container>
