<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity
        name="Sulu\Article\Domain\Model\ArticleDimensionContentAdditionalWebspace"
        table="ar_article_dimension_content_additional_webspaces"
    >
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="additionalWebspace" type="string" column="name" length="31" />

        <many-to-one field="articleDimensionContent" target-entity="Sulu\Article\Domain\Model\ArticleDimensionContent" inversed-by="additionalWebspaces">
            <join-column name="article_dimension_content_id" referenced-column-name="id" on-delete="CASCADE" nullable="false" />
        </many-to-one>

        <indexes>
            <index name="idx_article_additional_webspace" fields="additionalWebspace"/>
        </indexes>
    </entity>
</doctrine-mapping>
