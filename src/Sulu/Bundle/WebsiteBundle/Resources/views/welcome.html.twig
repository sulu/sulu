<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sulu CMS – Welcome</title>
    <style>
        :root {
            --color-navy: #142d4b;
            --color-navy-dark: #0b1d33;
            --color-navy-border: #23374d;
            --color-navy-button: #28394d;
            --color-text: #343434;
            --color-muted: #777777;
            --color-muted-light: #9aacc0;
            --color-code-text: #c9d6e3;
            --color-white: #ffffff;
            --color-border: #d4dce5;
            --color-blue: #5cbacc;
            --color-green: #1f883d;
            --color-green-light: #e7f4eb;
            --shadow-terminal: rgb(0 0 0 / 25%);
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            color: var(--color-text);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            line-height: 1.6;
        }

        .container {
            display: flex;
            min-height: 100vh;
        }

        .left,
        .right {
            width: 50%;
            min-width: 0;
        }

        .left {
            display: flex;
            flex-direction: column;
            background: var(--color-white);
        }

        .left .container-padding {
            display: flex;
            flex: 1;
            flex-direction: column;
            width: 100%;
            max-width: 720px;
            margin: 0 auto;
            padding: 44px 8.1% 28px;
        }

        .logo {
            width: 133px;
            height: 34px;
            color: var(--color-navy);
        }

        .logo svg {
            display: block;
            width: 100%;
            height: 100%;
        }

        .welcome-content {
            margin-top: 118px;
        }

        .environment {
            display: inline-block;
            padding: 2px 9px;
            border: 1px solid var(--color-border);
            border-radius: 6px;
            color: var(--color-navy);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 12px;
            line-height: 1.6;
        }

        h1 {
            margin: 18px 0 14px;
            color: var(--color-navy);
            font-size: clamp(2.5rem, 4vw, 3.5rem);
            font-weight: 600;
            letter-spacing: -0.035em;
            line-height: 1.15;
        }

        .explainer {
            max-width: 540px;
            margin: 0;
            font-size: 18px;
            line-height: 1.55;
        }

        .steps {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin: 40px 0 38px;
        }

        .step {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            min-height: 44px;
        }

        .badge {
            display: flex;
            flex: 0 0 28px;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            margin-top: 2px;
            border-radius: 50%;
            font-size: 13px;
            font-weight: 600;
        }

        .badge.checked {
            background: var(--color-green);
            color: var(--color-white);
        }

        .badge.active {
            background: var(--color-blue);
            color: var(--color-navy);
        }

        .badge.empty {
            border: 1.5px solid var(--color-border);
            color: var(--color-muted);
        }

        .badge svg {
            width: 15px;
            height: 15px;
        }

        .step-copy {
            min-width: 0;
            line-height: 1.45;
        }

        .step .headline {
            display: block;
            color: var(--color-text);
            font-size: 15px;
            font-weight: 600;
        }

        .step.active-step .headline {
            color: var(--color-navy);
        }

        .step-status {
            display: block;
            color: var(--color-muted);
            font-size: 13px;
        }

        .step-status.done {
            color: var(--color-green);
        }

        .resources-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 28px;
            padding-left: 4px;
        }

        .resources-nav a {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: var(--color-navy);
            font-size: 14px;
            font-weight: 600;
            text-decoration: underline;
            text-underline-offset: 2px;
        }

        .external-icon {
            width: 12px;
            height: 12px;
            flex: 0 0 auto;
        }

        footer {
            margin-top: auto;
            padding-top: 48px;
            color: var(--color-muted);
            font-size: 12px;
        }

        .right {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px;
            background: var(--color-navy);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        }

        .right .container-padding {
            width: 100%;
            max-width: 576px;
        }

        .code-block {
            overflow: hidden;
            padding-bottom: 22px;
            border: 1px solid var(--color-navy-border);
            border-radius: 13px;
            background: var(--color-navy-dark);
            box-shadow: 10px 10px 24px var(--shadow-terminal);
            color: var(--color-code-text);
        }

        .code-block .headline {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            min-height: 55px;
            padding: 9px 10px 9px 16px;
            color: var(--color-muted-light);
            font-size: 12px;
        }

        .code-block button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 8px 12px;
            border: 0;
            border-radius: 7px;
            background: var(--color-navy-button);
            color: var(--color-white);
            font: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .code-block button:hover {
            filter: brightness(1.15);
        }

        .copy-icon {
            width: 15px;
            height: 15px;
        }

        hr {
            width: 100%;
            margin: 0;
            border: 0;
            border-top: 1px solid var(--color-navy-border);
        }

        .command-to-run {
            margin: 24px 0 22px;
            padding: 0 16px;
            color: var(--color-white);
            font-size: clamp(14px, 1.35vw, 18px);
            font-weight: 600;
            white-space: nowrap;
        }

        .prompt,
        .cursor {
            color: var(--color-blue);
        }

        .cursor {
            display: inline-block;
            width: 10px;
            height: 22px;
            margin-left: 2px;
            vertical-align: -4px;
            background: var(--color-blue);
        }

        .commands {
            padding: 0 16px;
            font-size: 14px;
            line-height: 2.25;
        }

        .commands .comment {
            color: var(--color-muted-light);
        }

        .run-hint {
            margin-top: 16px;
            color: var(--color-muted-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            font-size: 13px;
            text-align: center;
        }

        @media (max-width: 900px) {
            .left .container-padding {
                padding-right: 7%;
                padding-left: 7%;
            }

            .right {
                padding: 28px;
            }

            .welcome-content {
                margin-top: 80px;
            }

            .resources-nav {
                gap: 16px;
            }
        }

        @media (max-width: 700px) {
            .container {
                flex-direction: column;
            }

            .left,
            .right {
                width: 100%;
            }

            .left .container-padding {
                min-height: 100vh;
                padding: 32px 8%;
            }

            .welcome-content {
                margin-top: 72px;
            }

            h1 {
                font-size: 42px;
            }

            .explainer {
                font-size: 16px;
            }

            .right {
                min-height: 420px;
                padding: 48px 8%;
            }

            .command-to-run {
                font-size: clamp(13px, 3.5vw, 17px);
            }
        }
    </style>
    <script>
        function copyCommandToClipboard() {
            navigator.clipboard.writeText('bin/console sulu:build dev');
        }
    </script>
</head>
<body>
    <main class="container">
        <section class="left">
            <div class="container-padding">
                <div class="logo" aria-label="Sulu">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 133 34"><defs><path id="a" d="M0 0h80v52H0z"/><path id="c" d="M0 0h95.135v96.417H0z"/><path id="e" d="M65.242 34.82V.151H.282v69.338h64.96V34.82z"/><path id="g" d="M0 0h76v37H0z"/><path id="i" d="M49.377 26.453V.115H.214V52.79h49.163V26.453z"/></defs><g fill="none" fill-rule="evenodd"><g transform="translate(-14 -6)"><mask id="b" fill="#fff"><use xlink:href="#a"/></mask><g mask="url(#b)"><g transform="translate(-9.362 -3.41)"><mask id="d" fill="#fff"><use xlink:href="#c"/></mask><g mask="url(#d)"><g transform="translate(21.362 9.41)"><mask id="f" fill="#fff"><use xlink:href="#e"/></mask><g fill="currentColor" fill-rule="nonzero" mask="url(#f)"><path d="M83.285 22.135V10.948c0-.791 0-1.017.223-1.356.223-.452.668-.678 1.225-.678s1.003.226 1.226.678c.222.339.222.678.222 1.356v11.074c0 2.712 1.56 4.294 4.01 4.294 2.45 0 4.01-1.695 4.01-4.294V10.948c0-.791 0-1.017.223-1.356.223-.452.668-.678 1.225-.678s1.003.226 1.225.678c.223.339.223.678.223 1.356v11.187c0 4.068-3.007 6.893-7.017 6.893-3.787-.113-6.795-2.825-6.795-6.893M110.575 28.35c-.446-.452-.446-1.017-.446-1.47V10.836c0-.791 0-1.017.223-1.356.223-.452.668-.678 1.225-.678s1.003.226 1.225.678c.223.339.223.678.223 1.356V26.09h7.686c.668 0 .89 0 1.225.226.334.226.557.565.557 1.13s-.223.904-.557 1.13c-.334.113-.557.226-1.225.226h-8.8c-.445 0-.89 0-1.336-.452M133.743 22.135V10.948c0-.791 0-1.017.222-1.356.223-.452.669-.678 1.226-.678.557 0 1.002.226 1.225.678.223.339.223.678.223 1.356v11.074c0 2.712 1.56 4.294 4.01 4.294 2.45 0 4.01-1.695 4.01-4.294V10.948c0-.791 0-1.017.222-1.356.223-.452.669-.678 1.225-.678.557 0 1.003.226 1.226.678.222.339.222.678.222 1.356v11.187c0 4.068-3.007 6.893-7.017 6.893-3.787-.113-6.794-2.825-6.794-6.893"/></g></g></g></g></g></g><g transform="translate(57 -1)"><mask id="h" fill="#fff"><use xlink:href="#g"/></mask><g mask="url(#h)"><path fill="currentColor" d="M13.628 21.04c0-.638-.159-1.136-.556-1.475-.357-.318-.834-.497