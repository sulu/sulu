            >
              Default
            </div>
            <span
              aria-label="su-expand-vertical"
              class="su-expand-vertical"
            />
          </header>
          <article
            class="children"
          >
            <p>
              media_selection
            </p>
            <p>
              text_line
            </p>
            <p>
              text_editor
            </p>
          </article>
        </div>
      </section>
      <div
        class="addButtonContainer addButtonDivider"
      >
        <button
          class="button secondary hasText addButton"
          type="button"
        >
          <span
            aria-label="su-plus"
            class="su-plus buttonIcon"
          />
          <span
            class="buttonText"
          >
            sulu_admin.add_block
          </span>
        </button>
      </div>
      <section
        class="block"
        role="switch"
      >
        <div
          class="handle"
        >
          <span
            aria-label="su-more"
            class="su-more sortableHandle"
          />
        </div>
        <div
          class="content"
        >
          <header
            class="header"
          >
            <div
              class="type"
            >
              Default
            </div>
            <span
              aria-label="su-expand-vertical"
              class="su-expand-vertical"
            />
          </header>
          <article
            class="children"
          >
            <p>
              media_selection
            </p>
            <p>
              text_line
            </p>
            <p>
              text_editor
            </p>
          </article>
        </div>
      </section>
    </div>
    <div
      class="addButtonContainer"
    >
      <button
        class="button secondary hasText addButton"
        type="button"
      >
        <span
          aria-label="su-plus"
          class="su-plus buttonIcon"
        />
        <span
          class="buttonText"
        >
          sulu_admin.add_block
        </span>
