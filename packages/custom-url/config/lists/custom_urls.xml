<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>custom_urls</key>

    <joins name="creator">
        <join>
            <entity-name>%sulu.model.user.class%</entity-name>
            <field-name>Sulu\CustomUrl\Domain\Model\CustomUrlInterface.creator</field-name>
        </join>
        <join>
            <entity-name>%sulu.model.contact.class%</entity-name>
            <field-name>%sulu.model.user.class%.contact</field-name>
        </join>
    </joins>
    <joins name="changer">
        <join>
            <entity-name>%sulu.model.user.class%</entity-name>
            <field-name>Sulu\CustomUrl\Domain\Model\CustomUrlInterface.changer</field-name>
        </join>
        <join>
            <entity-name>%sulu.model.contact.class%</entity-name>
            <field-name>%sulu.model.user.class%.contact</field-name>
        </join>
    </joins>

    <joins name="targetPage">
        <join>
            <entity-name>Sulu\Page\Domain\Model\PageInterface</entity-name>
            <method>LEFT</method>
            <condition>Sulu\Page\Domain\Model\PageInterface.uuid = Sulu\CustomUrl\Domain\Model\CustomUrlInterface.targetDocument</condition>
        </join>
    </joins>

    <joins name="targetPageDimensionContent" ref="targetPage">
        <join>
            <entity-name>targetPageDimensionContent</entity-name>
            <field-name>Sulu\Page\Domain\Model\PageInterface.dimensionContents</field-name>
            <method>LEFT</method>
            <condition>targetPageDimensionContent.locale = Sulu\CustomUrl\Domain\Model\CustomUrlInterface.targetLocale AND targetPageDimensionContent.stage = 'draft' AND targetPageDimensionContent.version = 0</condition>
        </join>
    </joins>

    <properties>
        <!-- TODO should be uuid not id -->
        <property name="id" visibility="no" translation="sulu_admin.uuid">
            <field-name>uuid</field-name>
            <entity-name>Sulu\CustomUrl\Domain\Model\CustomUrlInterface</entity-name>
        </property>

        <property name="title" visibility="always" translation="sulu_admin.title" sortable="false" searchability="yes">
            <field-name>title</field-name>
            <entity-name>Sulu\CustomUrl\Domain\Model\CustomUrlInterface</entity-name>
            <filter type="text" />
        </property>

        <property name="targetLocale" visibility="always" translation="sulu_custom_url.target_locale" sortable="false">
            <field-name>targetLocale</field-name>
            <entity-name>Sulu\CustomUrl\Domain\Model\CustomUrlInterface</entity-name>
        </property>

        <property name="targetPageTitle" visibility="always" translation="sulu_custom_url.target_page" sortable="false">
            <field-name>title</field-name>
            <entity-name>targetPageDimensionContent</entity-name>
            <joins ref="targetPageDimensionContent"/>
        </property>

         <property name="webspace" visibility="never" sortable="false" searchability="never">
            <field-name>webspace</field-name>
            <entity-name>Sulu\CustomUrl\Domain\Model\CustomUrlInterface</entity-name>
        </property>

        <property name="publishedState" visibility="never" translation="sulu_custom_url.published" sortable="false">
            <field-name>published</field-name>
            <entity-name>Sulu\CustomUrl\Domain\Model\CustomUrlInterface</entity-name>
        </property>

        <property
            name="created"
            translation="sulu_admin.created"
            sortable="false"
        >
            <field-name>created</field-name>
            <entity-name>Sulu\CustomUrl\Domain\Model\CustomUrlInterface</entity-name>
            <transformer type="datetime"/>
        </property>

        <property
            name="changed"
            translation="sulu_admin.created"
            sortable="false"
        >
            <field-name>changed</field-name>
            <entity-name>Sulu\CustomUrl\Domain\Model\CustomUrlInterface</entity-name>
            <transformer type="datetime"/>
        </property>

        <concatenation-property name="creator" visibility="yes" glue=" "
                                translation="sulu_admin.creator" sortable="false">
            <field>
                <field-name>firstName</field-name>
                <entity-name>%sulu.model.contact.class%</entity-name>

                <joins ref="creator"/>
            </field>
            <field>
                <field-name>lastName</field-name>
                <entity-name>%sulu.model.contact.class%</entity-name>

                <joins ref="creator"/>
            </field>
        </concatenation-property>

        <concatenation-property name="changer" glue=" " translation="sulu_admin.changer"
                                sortable="false">
            <field>
                <field-name>firstName</field-name>
                <entity-name>%sulu.model.contact.class%</entity-name>

                <joins ref="changer"/>
            </field>
            <field>
                <field-name>lastName</field-name>
                <entity-name>%sulu.model.contact.class%</entity-name>

                <joins ref="changer"/>
            </field>
        </concatenation-property>
    </properties>
</list>
