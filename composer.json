        "doctrine/dbal": "^3.9 || ^4.0",
        "doctrine/doctrine-bundle": "^2.6 || ^3.0",
        "doctrine/doctrine-fixtures-bundle": "^3.4 || ^4.0",
        "doctrine/doctrine-migrations-bundle": "^3.7 || ^4.0",
        "doctrine/inflector": "^1.4.1 || ^2.0.1",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^2.17.3 || ^3.3",
        "doctrine/persistence": "^3.1 || ^4.0",
        "dragonmantank/cron-expression": "^1.1 || ^2.0 || ^3.0",
        "friendsofsymfony/http-cache": "^3.0",
        "friendsofsymfony/http-cache-bundle": "^3.0",
        "friendsofsymfony/jsrouting-bundle": "^3.6",
        "friendsofsymfony/rest-bundle": "^3.2",
        "gedmo/doctrine-extensions": "^3.8",
        "guzzlehttp/promises": "^1.0 || ^2.0 || ^3.0",
        "handcraftedinthealps/goodby-csv": "^1.4",
        "imagine/imagine": "^1.0",
        "jms/serializer": "^3.19",
        "jms/serializer-bundle": "^4.0.1 || ^5.0",
        "league/flysystem": "^3.0",
        "league/flysystem-bundle": "^3.0",
        "massive/build-bundle": "^0.5.7 || ^0.6 || ^1.0",
        "matomo/device-detector": "^3.9 || ^4.0.1 || ^5.0 || ^6.0",
        "nyholm/psr7": "^1.3",
        "oro/doctrine-extensions": "^1.0.8 || ^2.0 || ^3.0",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/container": "^1.0 || ^2.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "stof/doctrine-extensions-bundle": "^1.7",
        "sulu/messenger": "^0.2 || ^1.0",
        "symfony-cmf/routing": "^3.0",
        "symfony-cmf/routing-bundle": "^3.0",
        "symfony/asset": "^6.4 || ^7.1 || ^8.0",
        "symfony/cache": "^6.4 || ^7.1 || ^8.0",
        "symfony/config": "^6.4 || ^7.1 || ^8.0",
        "symfony/console": "^6.4 || ^7.1 || ^8.0",
        "symfony/css-selector": "^6.4 || ^7.1 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.1 || ^8.0",
        "symfony/deprecation-contracts": "^2.5 || ^3.0",
        "symfony/doctrine-bridge": "^6.4 || ^7.1 || ^8.0",
        "symfony/error-handler": "^6.4 || ^7.1 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.1 || ^8.0",
        "symfony/event-dispatcher-contracts": "^2.5 || ^3.0",
        "symfony/expression-language": "^6.4 || ^7.1 || ^8.0",
        "symfony/filesystem": "^6.4 || ^7.1 || ^8.0",
        "symfony/finder": "^6.4 || ^7.1 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.1 || ^8.0",
        "symfony/html-sanitizer": "^6.4 || ^7.1 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.1 || ^8.0",
        "symfony/http-client-contracts": "^2.4 || ^3.0",
        "symfony/http-foundation": "^6.4 || ^7.1 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.1 || ^8.0",
        "symfony/intl": "^6.4 || ^7.1 || ^8.0",
        "symfony/mailer": "^6.4 || ^7.1 || ^8.0",
        "symfony/messenger": "^6.4 || ^7.1 || ^8.0",
        "symfony/mime": "^6.4 || ^7.1 || ^8.0",
        "symfony/password-hasher": "^6.4 || ^7.1 || ^8.0",
        "symfony/process": "^6.4 || ^7.1 || ^8.0",
        "symfony/property-access": "^6.4 || ^7.1 || ^8.0",
        "symfony/routing": "^6.4 || ^7.1 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.1 || ^8.0",
        "symfony/security-core": "^6.4 || ^7.1 || ^8.0",
        "symfony/security-http": "^6.4 || ^7.1 || ^8.0",
        "symfony/serializer": "^6.4 || ^7.1 || ^8.0",
        "symfony/service-contracts": "^1.0 || ^2.0 || ^3.0",
        "symfony/string": "^6.4 || ^7.1 || ^8.0",
        "symfony/translation": "^6.4 || ^7.1 || ^8.0",
        "symfony/translation-contracts": "^2.5 || ^3.0",
        "symfony/twig-bridge": "^6.4 || ^7.1 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.1 || ^8.0",
        "symfony/uid": "^6.4 || ^7.1 || ^8.0",
        "symfony/validator": "^6.4 || ^7.1 || ^8.0",
        "symfony/var-exporter": "^6.4 || ^7.1 || ^8.0",
        "symfony/workflow": "^6.4 || ^7.1 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.1 || ^8.0",
        "toflar/psr6-symfony-http-cache-store": "^4.0",
        "twig/twig": "^2.13 || ^3.0",
        "webmozart/assert": "^1.11 || ^2.0"
    },
    "require-dev": {
        "cmsig/seal-loupe-adapter": "^0.12.2",
        "cmsig/seal-memory-adapter": "^0.12.2",
        "coduo/php-matcher": "^6.0.14",
        "jangregor/phpstan-prophecy": "^2.0",
        "league/flysystem-memory": "^3.0",
        "matthiasnoback/symfony-config-test": "^6.0",
        "matthiasnoback/symfony-dependency-injection-test": "^6.1",
        "monolog/monolog": "^1.26.1 || ^2.3 || ^3.0",
        "php-cs-fixer/shim": "^3.14",
        "php-ffmpeg/php-ffmpeg": "^1.0",
        "phpspec/prophecy": "^1.18",
        "phpspec/prophecy-phpunit": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.1 || ^13.0",
        "rector/rector": "^2.0",
        "rokka/imagine-vips": "0.20 - 0.41",
        "scheb/2fa-backup-code": "^6.10 || ^7.0 || ^8.0",
        "scheb/2fa-bundle": "^6.10 || ^7.0 || ^8.0",
        "scheb/2fa-email": "^6.10 || ^7.0 || ^8.0",
        "scheb/2fa-google-authenticator": "^6.10 || ^7.0 || ^8.0",
        "scheb/2fa-totp": "^6.10 || ^7.0 || ^8.0",
        "scheb/2fa-trusted-device": "^6.0 || ^7.0 || ^8.0",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "spaze/phpstan-disallowed-calls": "^4.7",
        "symfony/browser-kit": "^6.4 || ^7.1 || ^8.0",
        "symfony/debug-bundle": "^6.4 || ^7.1 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.1 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.1 || ^8.0",
        "symfony/emoji": "^7.1 || ^8.0",
        "symfony/lock": "^6.4 || ^7.1 || ^8.0",
        "symfony/monolog-bundle": "^3.7 || ^4.0",
        "symfony/notifier": "^6.4 || ^7.1 || ^8.0",
        "symfony/phpunit-bridge": "^6.4 || ^7.1 || ^8.0",
        "symfony/runtime": "^6.4 || ^7.1 || ^8.0",
        "symfony/stopwatch": "^6.4 || ^7.1 || ^8.0",
        "symfony/var-dumper": "^6.4 || ^7.1 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.1 || ^8.0"
    },
    "conflict": {
        "doctrine/doctrine-bundle": "2.13.1 || 2.13.x-dev || 2.14.x-dev",
        "doctrine/orm": "3.7.x-dev",
        "jms/serializer-bundle": "4.1.0",
        "oro/doctrine-extensions": "2.0.3 || 2.0.4",
        "php-http/discovery": "< 1.8.0",
        "rokka/imagine-vips": "< 0.20 || >= 0.42",
        "scheb/2fa-backup-code": "< 6.10 || >= 9.0",
        "scheb/2fa-bundle": "< 6.10 || >= 9.0",
        "scheb/2fa-email": "< 6.10 || >= 9.0",
        "scheb/2fa-google-authenticator": "< 6.10 || >= 9.0",
        "scheb/2fa-totp": "< 6.10 || >= 9.0",
        "scheb/2fa-trusted-device": "< 6.10 || >= 9.0",
        "spomky-labs/otphp": "< 11.1",
        "symfony/notifier": "< 6.4 || >= 9.0",
        "thecodingmachine/safe": "< 2.0.0"
    },
    "replace": {
        "sulu/article-bundle": "self.version",
        "sulu/content-bundle": "self.version",
        "sulu/page-bundle": "self.version",
        "sulu/document-manager": "self.version",
        "sulu/media-bundle": "self.version",
        "sulu/notifier-bundle": "self.version",
        "sulu/tag-bundle": "self.version",
        "sulu/category-bundle": "self.version",
        "sulu/test-bundle": "self.version",
        "sulu/search-bundle": "self.version",
        "sulu/security-bundle": "self.version",
        "sulu/website-bundle": "self.version",
        "sulu/admin-bundle": "self.version",
        "sulu/contact-bundle": "self.version",
        "sulu/snippet-bundle": "self.version",
        "sulu/location-bundle": "self.version",
        "sulu/translate-bundle": "self.version"
    },
    "suggest": {
        "ext-fileinfo": "* - Needed to recognize file types of uploaded files",
        "ext-zip": "* - Needed by the download commands for the admin build and its translations",
        "ext-exif": "* - Needed to automatically rotate uploaded images based on their EXIF information",
        "rokka/imagine-vips": "^0.41 - Rendering formats by using the libvips",
        "php-ffmpeg/php-ffmpeg": "Needed (as in require-dev) to generate preview images for videos",
        "scheb/2fa-bundle": "Needed for two factor authentication.",
        "scheb/2fa-totp": "Needed for two factor authentication via authenticator apps (TOTP).",
        "scheb/2fa-google-authenticator": "Needed for two factor authentication via authenticator apps (Google Authenticator).",
        "scheb/2fa-backup-code": "Needed for two factor authentication backup codes.",
        "scheb/2fa-trusted-device": "Needed to allow trusted devices to skip the two factor authentication.",
        "symfony/notifier": "^6.4 || ^7.1 || ^8.0 - Needed by the SuluNotifierBundle to send notifications",
        "symfony/monolog-bundle": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Sulu\\": "src/Sulu/",
            "Sulu\\Article\\": "packages/article/src",
            "Sulu\\Snippet\\": "packages/snippet/src",
            "Sulu\\Page\\": "packages/page/src",
            "Sulu\\Route\\": "packages/route/src",
            "Sulu\\Search\\": "packages/search/src",
            "Sulu\\Content\\": "packages/content/src",
            "Sulu\\CustomUrl\\": "packages/custom-url/src",
            "Sulu\\Notifier\\": "packages/notifier/src"
        },
        "exclude-from-classmap": [
            "src/Sulu/Component/*/Tests/",
            "src/Sulu/Bundle/*/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/",
            "Sulu\\Article\\Tests\\": "packages/article/tests",
            "Sulu\\Article\\Migrations\\": "packages/article/migrations",
            "Sulu\\Snippet\\Tests\\": "packages/snippet/tests",
            "Sulu\\Snippet\\Migrations\\": "packages/snippet/migrations",
            "Sulu\\Page\\Tests\\": "packages/page/tests",
            "Sulu\\Page\\Migrations\\": "packages/page/migrations",
            "Sulu\\Route\\Tests\\": "packages/route/tests",
            "Sulu\\Route\\Migrations\\": "packages/route/migrations",
            "Sulu\\Search\\Tests\\": "packages/search/tests",
            "Sulu\\Content\\Tests\\": "packages/content/tests",
            "Sulu\\Content\\Migrations\\": "packages/content/migrations",
            "Sulu\\CustomUrl\\Tests\\": "packages/custom-url/tests",
            "Sulu\\Notifier\\Tests\\": "packages/notifier/tests"
        }
    },
    "scripts": {
        "bootstrap-test-environment": [
            "@php bin/runtests --initialize --no-bundle-tests --no-component-tests"
        ],
        "lint": [
            "@lint-twig",
            "@lint-yaml",
            "@lint-container",
            "@lint-composer",
            "@lint-composer-dependencies",
            "@lint-doctrine",
            "@lint-rector",
            "@lint-translations",
            "@php-cs",
            "@phpstan"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/runtests --all"
        ],
        "phpstan": [
            "@php bin/adminconsole cache:warmup --env=dev",
            "@php vendor/bin/phpstan analyse"
        ],
        "fix": [
            "@rector",
            "@php-cs-fix"
        ],
        "php-cs": "@php vendor/bin/php-cs-fixer fix --verbose --diff --dry-run",
        "php-cs-fix": "@php vendor/bin/php-cs-fixer fix",
        "lint-rector": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/websiteconsole cache:warmup --env=dev",
            "@php bin/adminconsole cache:warmup --env=dev",
            "@php vendor/bin/rector process --dry-run"
        ],
        "rector": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/websiteconsole cache:warmup --env=dev",
            "@php bin/adminconsole cache:warmup --env=dev",
            "@php vendor/bin/rector process"
        ],
        "lint-composer": "@composer validate --strict",
        "lint-composer-dependencies": "@php vendor/bin/composer-dependency-analyser --show-all-usages",
        "lint-twig": "@php bin/adminconsole lint:twig templates",
        "lint-yaml": "@php bin/adminconsole lint:yaml config",
        "lint-translations": [
            "@php bin/console debug:translation --all en --only-missing",
            "@php bin/console debug:translation --all de --only-missing"
        ],
        "lint-container": [
            "@php bin/adminconsole lint:container --env dev",
            "@php bin/websiteconsole lint:container --env dev",
            "@php bin/adminconsole lint:container --env test",
            "@php bin/websiteconsole lint:container --env test",
            "@php bin/adminconsole lint:container --env stage",
            "@php bin/websiteconsole lint:container --env stage",
            "@php bin/adminconsole lint:container --env prod",
            "@php bin/websiteconsole lint:container --env prod"
        ],
        "lint-doctrine": [
            "@php bin/adminconsole doctrine:schema:validate --skip-sync"
        ]
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/runtime": true,
            "php-http/discovery": true
        }
    }
}
