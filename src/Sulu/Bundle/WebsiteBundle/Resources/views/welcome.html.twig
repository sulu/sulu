<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sulu CMS – Welcome</title>
    <style>
        :root {
            --right-blue-background: #112a46;
            --blue-terminal: #0b1d33;
            --muted-white: #6e6e6e;
            --text-color: #343434;
            --light-blue: #5cbacc;
            --green: #1f883d;
        }
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            color: #212529;
            line-height: 1.6;
        }

        .container {
            display: flex;
            flex-direction: row;
            min-height: 100vh;
        }
        .container > * {
            width: 100%;
        }
        .container-padding {
            margin: auto;
            max-width: 80%;

        }

        .left {
            color: var(--text-color);
        }
        .left .container-padding {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 90%;
            margin-top: 5%;
        }
        h1 {
            color: #2f445d;
            font-size: 80px;
            margin: 0;
            font-weight:normal;
        }
        .explainer {
            font-size: 14pt;
        }
        .logo {
            max-width: 10rem;
        }

        .environment {
            border: 1px solid silver;
            border-radius: 7px;
            padding: .25rem;
        }
        .steps {
            display: flex;
            flex-direction:column;
            gap: 1.5rem;
            margin: 2rem 0;
        }

        .step {
            display: flex;
            gap: 1rem;
        }

        .step .headline {
            font-weight: bold;
        }

        .badge {
            width: 50px;
            height: 50px;

            border-radius: 100%;
            position: relative;
        }

        .badge p {
            margin: 0;
            position: absolute;
            left: 50%;
            top: 25%;
            transform: translate(-50%);
            font-weight: bold;
        }

        .badge.checked {
            background-color: var(--green);
        }
        .badge.active {
            background-color: var(--light-blue);
        }
        .badge.empty {
            border: 3px solid silver;
        }

        .resources-nav {
            display: flex;
            gap: 1rem;
        }

        .resources-nav a {
            font-weight: bold;
        }

        footer {
            color: var(--muted-white);
            padding: 1rem 0;
        }

        .right {
            background: var(--right-blue-background);
            font-family: monospace;
            position: relative;
        }

        .code-block {
            background-color: var(--blue-terminal);
            color: #c9d6e3;
            filter: drop-shadow(10px 10px 4px rgba(0,0,0,.25));
            border: 1px solid #233447;
            padding-bottom: 1rem;
            margin-bottom: .5rem;
            border-radius: 1rem;
        }
        .code-block .headline {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 0.5rem 0.5rem 0.5rem 1rem;
        }

        .code-block button {
            font-weight: bold;
            color: white;
            background:;
            border: 0;
            background-color: #28384b;
            padding: .5rem;
            border-radius: .5rem;
        }
        hr {
            border: 1px solid #233447;
            width: 100%;
            margin: 0;
        }
        .command-to-run {
            color: white;
            font-size: 150%;
            font-weight: bold;
            margin: 1rem 0;
            padding: 0.5rem 0.5rem 0.5rem 1rem;
        }

        .right .container-padding {
            position: absolute;
            width:80%;
            top: 25%;
            left: 50%;
            transform: translateX(-50%);
        }

        .commands {
            line-height: 2;
            padding: 0.5rem 0.5rem 0.5rem 1rem;
        }

    </style>
    <script>
        function copyCommandToClipboard() {
            navigator.clipboard.writeText('bin/console sulu:build dev');
        }
    </script>
</head>
<body>
    <div class="container">
        <div class="left">
            <section class="container-padding">
                <div class="logo">
