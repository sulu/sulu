<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Normalizer -->
        <service id="sulu_content.dimension_content_normalizer" class="Sulu\Content\Application\ContentNormalizer\Normalizer\DimensionContentNormalizer">
            <tag name="sulu_content.normalizer" priority="256"/>
        </service>

        <service id="sulu_content.template_normalizer" class="Sulu\Content\Application\ContentNormalizer\Normalizer\TemplateNormalizer">
            <tag name="sulu_content.normalizer" priority="128"/>
        </service>

        <service id="sulu_content.workflow_normalizer" class="Sulu\Content\Application\ContentNormalizer\Normalizer\WorkflowNormalizer">
            <tag name="sulu_content.normalizer" priority="64"/>
        </service>

        <service id="sulu_content.excerpt_normalizer" class="Sulu\Content\Application\ContentNormalizer\Normalizer\ExcerptNormalizer">
            <tag name="sulu_content.normalizer" priority="32"/>
        </service>

        <service id="sulu_content.routable_normalizer" class="Sulu\Content\Application\ContentNormalizer\Normalizer\RoutableNormalizer">
            <tag name="sulu_content.normalizer" priority="16"/>
        </service>

        <service id="sulu_content.author_normalizer" class="Sulu\Content\Application\ContentNormalizer\Normalizer\AuthorNormalizer">
            <tag name="sulu_content.normalizer" priority="8"/>
        </service>

        <service id="sulu_content.link_normalizer" class="Sulu\Content\Application\ContentNormalizer\Normalizer\LinkNormalizer">
            <tag name="sulu_content.normalizer" priority="6"/>
        </service>

        <service id="sulu_content.shadow_normalizer" class="Sulu\Content\Application\ContentNormalizer\Normalizer\ShadowNormalizer">
            <tag name="sulu_content.normalizer" priority="4"/>
        </service>

        <service id="sulu_content.auditable_normalizer" class="Sulu\Content\Application\ContentNormalizer\Normalizer\AuditableNormalizer">
            <tag name="sulu_content.normalizer" priority="2"/>
        </service>

        <service id="sulu_content.secured_entity_normalizer" class="Sulu\Content\Application\ContentNormalizer\Normalizer\SecuredEntityNormalizer">
            <argument type="service" id="sulu_security.access_control_manager"/>
            <argument type="service" id="security.token_storage" on-invalid="null"/>
            <tag name="sulu_content.normalizer" priority="1"/>
        </service>
    </services>
</container>
