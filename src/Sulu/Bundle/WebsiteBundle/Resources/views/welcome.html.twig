678 1.13 1.469 1.807 1.582l26.644 5.424c.79.113 1.693-.226 2.145-.904l8.693-13.56Zm-24.16-6.893c-.452.565-1.468 1.017-2.258.79L6.197 10.61c-.79-.113-.79-.452 0-.678l20.774-6.554c.79-.226 1.016.113.565.678l-6.661 8.249Zm8.467-7.684c.452-.565.903-.452 1.016.226l2.484 23.052c.113.791-.226.904-.677.226L22.568 15.58c-.451-.565-.451-1.582 0-2.147l6.774-8.814ZM3.037 12.982c-.226-.678.113-1.13.903-1.017l14.564 3.05c.79.114 1.806.792 2.258 1.357l10.5 13.673c.451.565.225 1.017-.565.791L9.133 26.542c-.79-.113-1.58-.904-1.806-1.582l-4.29-11.978Zm30.257.113c-.113-.791.338-1.017 1.016-.565l7.677 5.31c.677.453.79 1.357.452 1.922l-6.436 9.944c-.451.678-.79.565-.903-.226l-1.806-16.385Z"/></g></svg>
                </div>
                    <div>
                        <code class="environment">APP_ENV=dev</code>
                        <h1> Welcome to Sulu</h1>
                        <p class="explainer">You're seeing this page because Sulu runs in dev and no initial data is loaded yet. It disappears as
                            soon as you load it.
                        </p>
                        <section class="steps">
                            <div class="step">
                                <div class="badge checked">Check</div>
                                <div>
                                    <span class="headline">Sulu initialized</span>
                                    <br>
                                    <span style="color: var(--green)">Done</span>
                                </div>
                            </div>
                            <div class="step">
                                <div class="badge checked">Check</div>
                                <div>
                                    <span class="headline">Database connected</span>
                                    <br>
                                    <span style="color: var(--green)">Done</span>
                                </div>
                            </div>
                            <div class="step">
                                <div class="badge active"><p>3</p></div>
                                <div>
                                    <span class="headline">Load the initial data</span>
                                    <br>
                                    <span style="color: var(--muted-white)">Copy the command on the right</span>
                                </div>
                            </div>
                            <div class="step">
                                <div class="badge empty"><p>4</p></div>
                                <div>
                                    <span>Open the admin</span>
                                    <br>
                                    <span style="color: var(--muted-white)">After the next relaod</span>
                                </div>
                            </div>
                        </section>
                        <nav class="resources-nav">
                            <a href="https://docs.sulu.io">Documentation</a>
                            <a href="https://github.com/sulu/sulu">GitHub</a>
                            <a href="https://sulu.io">sulu.io</a>
                        </nav>
                    </div>
                    <footer>Only shown in the dev environment while no initial data is loaded.</footer>
                </section>
            </div>
            <div class="right">
                <div class="container-padding">
                <div class="code-block">
                    <div class="headline">
                        <span>{{ workingDirectory }}</span>
                        <button onclick="copyCommandToClipboard()">Copy</button>
                    </div>
                    <hr>
                    <div class="command-to-run">
                        <span style="color: var(--light-blue)">$</span>
                        bin/console sulu:build dev<span style="color: var(--light-blue)">█</span>
                    </div>
                    <div class="commands">
                        <span style="color: #7f93a8"># what it does - wording to be confirmed</span>
                        <br>
                        -> set up the database
                        <br>
                        -> loads the initial database
                        <br>
                        -> then reload the page
                    </div>
                </div>
                <div style="color: #c9d6e3; text-align: center"> Run it in your project folder</div>
            </div>
        </div>
    </div>
</body>
</html>
