<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sulu CMS – Welcome</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #f8f9fa;
            color: #212529;
            line-height: 1.6;
        }

        .banner {
            background: #fff3cd;
            border-bottom: 1px solid #ffc107;
            padding: 1rem;
            text-align: center;
            font-weight: 600;
            color: #856404;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 4rem 2rem;
            text-align: center;
        }

        .logo {
            padding: 2rem 1rem;
            margin-bottom: 2rem;
        }

        .logo svg {
            width: 300px;
            max-width: 100%;
            height: auto;
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 600;
            margin: 0 0 1rem;
            color: #212529;
        }

        h2 {
            font-size: 1.75rem;
            font-weight: 500;
            margin: 2rem 0 1rem;
            color: #495057;
        }

        h3 {
            font-size: 1.25rem;
            font-weight: 500;
            margin: 3rem 0 1.5rem;
            color: #495057;
        }

        h4 {
            font-size: 1.125rem;
            font-weight: 600;
            margin: 0 0 0.5rem;
            color: #212529;
        }

        p {
            margin: 0;
            color: #6c757d;
            font-size: 0.9375rem;
        }

        .code-block {
            text-align: left;
            background: #212529;
            color: #52b6ca;
            padding: 1.5rem;
            border-radius: 8px;
            font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', 'source-code-pro', monospace;
            font-size: 0.9375rem;
            width: 100%;
            max-width: 500px;
            margin: 2rem auto;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .button {
            display: inline-block;
            color: #fff;
            background-color: #52b6ca;
            padding: 0.875rem 2rem;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 500;
            font-size: 1rem;
            transition: background-color 0.2s ease, transform 0.1s ease;
            margin: 1rem 0 3rem;
            box-shadow: 0 2px 4px rgba(82, 182, 202, 0.3);
        }

        .button:hover {
            background-color: #45a0b3;
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(82, 182, 202, 0.4);
        }

        .button:active {
            transform: translateY(0);
        }

        .resources-nav {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: center;
            gap: 2rem;
            margin: 2rem auto 0;
            max-width: 900px;
        }

        .docs-link {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: #212529;
            padding: 2rem 1.5rem;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            flex: 1;
            min-width: 200px;
            max-width: 280px;
        }

        .docs-link:hover {
            transform: translateY(-4px);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
        }

        .docs-link:hover h4 {
            color: #52b6ca;
        }

        .docs-link svg {
            width: 56px;
            height: 56px;
            margin-bottom: 1rem;
            transition: fill 0.2s ease;
        }

        .docs-link .icon-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .docs-link .icon-wrapper svg[viewBox="0 0 24 24"] {
            fill: #52b6ca;
        }

        .docs-link .icon-wrapper svg[viewBox="0 -0.5 25 25"] {
            fill: #52b6ca;
        }

        .docs-link .icon-wrapper svg[viewBox="0 0 420 420"] {
            stroke: #52b6ca;
        }

        @media (max-width: 768px) {
            .container {
                padding: 2rem 1rem;
            }

            h1 {
                font-size: 2rem;
            }

            h2 {
                font-size: 1.5rem;
            }

            .resources-nav {
                flex-direction: column;
                align-items: stretch;
            }

            .docs-link {
                max-width: 100%;
            }
        }
    </style>
</head>
<body>
