<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>snippets</key>

    <joins name="creator">
        <join>
            <entity-name>%sulu.model.user.class%</entity-name>
            <field-name>Sulu\Snippet\Domain\Model\SnippetInterface.creator</field-name>
        </join>
        <join>
            <entity-name>%sulu.model.contact.class%</entity-name>
            <field-name>%sulu.model.user.class%.contact</field-name>
        </join>
    </joins>
    <joins name="changer">
        <join>
            <entity-name>%sulu.model.user.class%</entity-name>
            <field-name>Sulu\Snippet\Domain\Model\SnippetInterface.changer</field-name>
        </join>
        <join>
            <entity-name>%sulu.model.contact.class%</entity-name>
            <field-name>%sulu.model.user.class%.contact</field-name>
        </join>
    </joins>

    <joins name="dimensionContent">
        <join>
            <entity-name>dimensionContent</entity-name>
            <field-name>Sulu\Snippet\Domain\Model\SnippetInterface.dimensionContents</field-name>
            <method>LEFT</method>
            <condition>dimensionContent.locale = :locale AND dimensionContent.stage = 'draft' AND dimensionContent.version = 0</condition>
        </join>
    </joins>

    <joins name="unlocalizedDimensionContent" ref="dimensionContent">
        <join>
            <entity-name>unlocalizedDimensionContent</entity-name>
            <field-name>Sulu\Snippet\Domain\Model\SnippetInterface.dimensionContents</field-name>
            <method>LEFT</method>
            <condition>unlocalizedDimensionContent.locale IS NULL AND unlocalizedDimensionContent.stage = 'draft' AND unlocalizedDimensionContent.version = 0</condition>
        </join>
    </joins>

    <joins name="ghostDimensionContent" ref="unlocalizedDimensionContent">
        <join>
            <entity-name>ghostDimensionContent</entity-name>
            <field-name>Sulu\Snippet\Domain\Model\SnippetInterface.dimensionContents</field-name>
            <method>LEFT</method>
            <condition>ghostDimensionContent.locale = unlocalizedDimensionContent.ghostLocale AND ghostDimensionContent.stage = 'draft' AND dimensionContent IS NULL AND ghostDimensionContent.version = 0</condition>
        </join>
    </joins>

    <joins name="shadowDimensionContent" ref="dimensionContent">
        <join>
            <entity-name>shadowDimensionContent</entity-name>
            <field-name>Sulu\Snippet\Domain\Model\SnippetInterface.dimensionContents</field-name>
            <method>LEFT</method>
            <condition>shadowDimensionContent.locale = dimensionContent.shadowLocale AND shadowDimensionContent.stage = 'draft' AND shadowDimensionContent.version = 0</condition>
        </join>
    </joins>

    <properties>
        <!-- TODO should be uuid not id -->
        <property name="id" translation="sulu_admin.uuid">
            <field-name>uuid</field-name>
            <entity-name>Sulu\Snippet\Domain\Model\SnippetInterface</entity-name>
        </property>

        <property name="version" visibility="never">
            <field-name>version</field-name>
            <entity-name>dimensionContent</entity-name>
        </property>

        <case-property name="title" translation="sulu_admin.title" visibility="always" searchability="yes">
            <field>
                <field-name>title</field-name>
                <entity-name>dimensionContent</entity-name>

                <joins ref="dimensionContent"/>
            </field>

            <field>
                <field-name>title</field-name>
                <entity-name>ghostDimensionContent</entity-name>

                <joins ref="ghostDimensionContent"/>
            </field>

            <transformer type="title"/>
        </case-property>

        <property name="created" translation="sulu_admin.created">
            <field-name>created</field-name>
            <entity-name>Sulu\Snippet\Domain\Model\SnippetInterface</entity-name>
            <transformer type="datetime"/>
        </property>

        <property name="changed" translation="sulu_admin.changed">
            <field-name>changed</field-name>
            <entity-name>Sulu\Snippet\Domain\Model\SnippetInterface</entity-name>
            <transformer type="datetime"/>
        </property>

        <concatenation-property name="creator" visibility="yes" glue=" "
                                translation="sulu_admin.creator" sortable="false">
            <field>
                <field-name>firstName</field-name>
                <entity-name>%sulu.model.contact.class%</entity-name>

                <joins ref="creator"/>
            </field>
            <field>
                <field-name>lastName</field-name>
                <entity-name>%sulu.model.contact.class%</entity-name>

                <joins ref="creator"/>
            </field>
        </concatenation-property>

        <concatenation-property name="changer" glue=" " translation="sulu_admin.changer"
                                sortable="false">
            <field>
                <field-name>firstName</field-name>
                <entity-name>%sulu.model.contact.class%</entity-name>

                <joins ref="changer"/>
            </field>
            <field>
                <field-name>lastName</field-name>
                <entity-name>%sulu.model.contact.class%</entity-name>

                <joins ref="changer"/>
            </field>
        </concatenation-property>

        <property name="locale" translation="sulu_admin.locale" visibility="never">
            <field-name>locale</field-name>
            <entity-name>dimensionContent</entity-name>
        </property>

        <property name="shadowLocale" translation="sulu_admin.shadow_locale" visibility="never">
            <field-name>locale</field-name>
            <entity-name>shadowDimensionContent</entity-name>

            <joins ref="shadowDimensionContent"/>
        </property>

        <property name="ghostLocale" translation="sulu_admin.ghost_locale" visibility="never">
            <field-name>locale</field-name>
            <entity-name>ghostDimensionContent</entity-name>
        </property>

        <property name="published" translation="sulu_admin.published" type="date" visibility="never">
            <field-name>workflowPublished</field-name>
            <entity-name>dimensionContent</entity-name>
            <transformer type="datetime"/>
        </property>

        <property name="publishedState" translation="sulu_content.published_state" visibility="never">
            <field-name>workflowPlace</field-name>
            <entity-name>dimensionContent</entity-name>

            <joins ref="dimensionContent"/>

            <filter type="select">
                <params>
                    <param name="options" type="collection">
                        <param name="published" value="sulu_content.state_published" />
                        <param name="unpublished" value="sulu_content.state_not_published" />
                        <param name="draft" value="sulu_admin.draft" />
                    </param>
                </params>
            </filter>
        </property>

        <case-property name="templateKey" visibility="yes" translation="sulu_admin.type">
            <field>
                <field-name>templateKey</field-name>
                <entity-name>dimensionContent</entity-name>

                <joins ref="dimensionContent"/>
            </field>
            <field>
                <field-name>templateKey</field-name>
                <entity-name>ghostDimensionContent</entity-name>

                <joins ref="ghostDimensionContent"/>
            </field>

            <transformer type="string"/>

            <filter type="select">
                <params>
                    <param name="options" type="expression" value="service('sulu_snippet.template_select_provider').getFilterValues(locale)" />
                </params>
            </filter>
        </case-property>

        <property name="categoryId" translation="sulu_category.categories" visibility="never">
            <field-name>id</field-name>
            <entity-name>excerptCategory</entity-name>

            <joins name="excerptCategory" ref="dimensionContent">
                <join>
                    <entity-name>excerptCategory</entity-name>
                    <field-name>dimensionContent.excerptCategories</field-name>
                </join>
            </joins>

            <filter type="selection">
                <params>
                    <param name="displayProperty" value="name" />
                    <param name="resourceKey" value="categories" />
                </params>
            </filter>
        </property>

        <property name="tagId" translation="sulu_tag.tags" visibility="never">
            <field-name>id</field-name>
            <entity-name>excerptTag</entity-name>

            <joins name="excerptTag" ref="dimensionContent">
                <join>
                    <entity-name>excerptTag</entity-name>
                    <field-name>dimensionContent.excerptTags</field-name>
                </join>
            </joins>

            <filter type="selection">
                <params>
                    <param name="displayProperty" value="name" />
                    <param name="resourceKey" value="tags" />
                </params>
            </filter>
        </property>
    </properties>
</list>
