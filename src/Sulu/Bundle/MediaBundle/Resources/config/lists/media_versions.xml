<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>media_versions</key>

    <joins name="file">
        <join>
            <entity-name>Sulu\Bundle\MediaBundle\Entity\File</entity-name>
            <field-name>Sulu\Bundle\MediaBundle\Entity\FileVersion.file</field-name>
        </join>
    </joins>

    <properties>
        <property name="id" translation="sulu_admin.id" visibility="never">
            <field-name>id</field-name>
            <entity-name>Sulu\Bundle\MediaBundle\Entity\FileVersion</entity-name>
        </property>

        <identity-property name="mediaId" visibility="never">
            <field-name>media</field-name>
            <entity-name>Sulu\Bundle\MediaBundle\Entity\File</entity-name>

            <joins ref="file"/>
        </identity-property>

        <property name="version" translation="sulu_media.version" visibility="always">
            <field-name>version</field-name>
            <entity-name>Sulu\Bundle\MediaBundle\Entity\FileVersion</entity-name>

            <transformer type="translation">
                <params>
                    <param name="key" value="sulu_media.version_label"/>
                </params>
            </transformer>
        </property>

        <property name="name" translation="sulu_admin.name" visibility="no">
            <field-name>name</field-name>
            <entity-name>Sulu\Bundle\MediaBundle\Entity\FileVersion</entity-name>
        </property>

        <property name="created" translation="sulu_admin.created" visibility="always">
            <field-name>created</field-name>
            <entity-name>Sulu\Bundle\MediaBundle\Entity\FileVersion</entity-name>

            <transformer type="datetime"/>
        </property>
    </properties>
</list>
