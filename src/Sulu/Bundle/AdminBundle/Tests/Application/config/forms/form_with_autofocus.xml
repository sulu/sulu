<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>form_with_autofocus</key>

    <properties>
        <property name="firstName" type="text_line" mandatory="true" colspan="6" autoFocus="true">
            <meta>
                <title lang="en">First Name</title>
                <title lang="de">Vorname</title>
            </meta>
        </property>

        <property name="lastName" type="text_line" mandatory="true" colspan="6">
            <meta>
                <title lang="en">Last Name</title>
                <title lang="de">Nachname</title>
            </meta>
        </property>

        <property name="email" type="email" colspan="6" autoFocus="false">
            <meta>
                <title lang="en">Email</title>
                <title lang="de">E-Mail</title>
            </meta>
        </property>
    </properties>
</form>
