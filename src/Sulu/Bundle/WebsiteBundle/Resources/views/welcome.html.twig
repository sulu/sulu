                </div>

                <div class="welcome-content">
                    <code class="environment">APP_ENV=dev</code>
                    <h1>Welcome to Sulu</h1>
                    <p class="explainer">You’re seeing this page because Sulu runs in dev and no initial data is loaded yet. It disappears as soon as you load it.</p>

                    <section class="steps" aria-label="Setup progress">
                        <div class="step">
                            <span class="badge checked" aria-label="Completed">
                                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12.5 4.2 4.2L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </span>
                            <div class="step-copy">
                                <span class="headline">Sulu installed</span>
                                <span class="step-status done">Done</span>
                            </div>
                        </div>
                        <div class="step">
                            <span class="badge checked" aria-label="Completed">
                                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12.5 4.2 4.2L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </span>
                            <div class="step-copy">
                                <span class="headline">Database connected</span>
                                <span class="step-status done">Done</span>
                            </div>
                        </div>
                        <div class="step active-step">
                            <span class="badge active" aria-label="Step 3">3</span>
                            <div class="step-copy">
                                <span class="headline">Load the initial data</span>
                                <span class="step-status">Copy the command on the right</span>
                            </div>
                        </div>
                        <div class="step">
                            <span class="badge empty" aria-label="Step 4">4</span>
                            <div class="step-copy">
                                <span class="headline">Open the admin</span>
                                <span class="step-status">After the next reload</span>
                            </div>
                        </div>
                    </section>

                    <nav class="resources-nav" aria-label="Sulu resources">
                        {% set links = {
                            "Documentation": "https://docs.sulu.io",
                            "GitHub": "https://github.com/sulu/sulu",
                            "sulu.io": "sulu.io",
                        } %}
                        {% for name, url in links %}
                            <a href="{{ url }}">{{ name }}
                                <svg class="external-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M9 2h5v5M14 2 7 9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 9v4H2V3h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </a>
                        {% endfor %}
                    </nav>
                </div>

                <footer>Only shown in the dev environment while no initial data is loaded.</footer>
            </div>
        </section>

        <section class="right" aria-label="Setup command">
            <div class="container-padding">
                <div class="code-block">
                    <div class="headline">
                        <span>{{ workingDirectory }}</span>
                        <button type="button" onclick="copyCommandToClipboard()">
                            <svg class="copy-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                            Copy
                        </button>
                    </div>
                    <hr />
                    <div class="command-to-run"><span class="prompt">$</span> bin/console sulu:build dev<span class="cursor" aria-hidden="true"></span></div>
                    <div class="commands">
                        <span class="comment"># what it does</span><br />
                        → sets up the database<br />
                        → loads the initial data<br />
                        → then reload this page
                    </div>
                </div>
                <div class="run-hint">Run it in your project folder.</div>
            </div>
        </section>
    </main>
</body>
</html>
